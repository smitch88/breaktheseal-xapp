{
  "name": "@bearish-af/seal-rips",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Break the Seal: real graded collectibles and XRPL NFTs, one bite at a time. Phase one: real catalog and art, demo pulls only.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-5340}",
    "build": "next build",
    "start": "next start --port ${PORT:-5340}",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "verify": "node --experimental-strip-types --no-warnings scripts/verify-log.mjs"
  },
  "dependencies": {
    "@joeywallet/wallet-sdk": "0.5.0",
    "@noble/hashes": "1.8.0",
    "@solana/web3.js": "1.98.4",
    "@vercel/functions": "3.10.5",
    "@walletconnect/types": "2.21.5",
    "@walletconnect/universal-provider": "2.21.5",
    "bs58": "6.0.0",
    "next": "16.3.4",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ripple-address-codec": "4.3.1",
    "ripple-keypairs": "1.3.1",
    "verify-xrpl-signature": "9.2.0",
    "xrpl": "4.7.0",
    "xrpl-binary-codec-prerelease": "9.2.0",
    "xumm-xapp-sdk": "1.7.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "^22.20.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "fast-check": "3.23.2",
    "sharp": ">=0.33",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.19.0"
